# Site / API (existing)
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SITE_ORIGIN=http://localhost:5173

# OneSignal web push — from dashboard → Settings → Keys & IDs
# Leave empty to disable the SDK entirely (prompt + Profile toggle stay hidden).
VITE_ONESIGNAL_APP_ID=

# PostHog — Ruchi Insights client analytics (leave empty to no-op)
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Project ID enables admin Usage deep-links (PostHog → Project settings)
# VITE_PUBLIC_POSTHOG_PROJECT_ID=
# Optional UI host override (defaults from API host region)
# VITE_PUBLIC_POSTHOG_UI=https://us.posthog.com

