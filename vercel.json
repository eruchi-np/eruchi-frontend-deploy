{
    "outputDirectory":  "dist",
    "buildCommand":  "npm run build",
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "https://api.eruchi.com.np/api/:path*"
                     },
                     {
                         "source":  "/((?!api/).*)",
                         "destination":  "/index.html"
                     }
                 ],
    "framework":  "vite"
}